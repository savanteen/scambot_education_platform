// Process user message and generate bot response
function processMessage(userMessage, conversationContext) {
  // Convert to lowercase for processing
  const normalizedMessage = userMessage.toLowerCase();
  
  // Check for game-ending phrases
  for (const phrase of gameEndingPhrases) {
    if (normalizedMessage.includes(phrase)) {
      return {
        response: "I think this conversation is over. I'll be reporting this to the authorities.",
        gameEnded: true,
        reason: "Triggered game-ending phrase: " + phrase
      };
    }
  }
  
  // Process message with Compromise.js
  const doc = nlp(normalizedMessage);
  
  // Update dimensions based on message content
  const dimensionImpacts = {};
  let totalImpact = 0;
  
  // Analyze for dimension impacts
  Object.keys(dimensionPatterns).forEach(dimension => {
    let impact = 0;
    
    // Check for positive patterns
    dimensionPatterns[dimension].positive.forEach(pattern => {
      if (normalizedMessage.includes(pattern)) {
        impact += 10; // Increase by 10% for each positive pattern
      }
    });
    
    // Check for negative patterns
    dimensionPatterns[dimension].negative.forEach(pattern => {
      if (normalizedMessage.includes(pattern)) {
        impact -= 5; // Decrease by 5% for each negative pattern
      }
    });
    
    // Record impact if non-zero
    if (impact !== 0) {
      dimensionImpacts[dimension] = impact;
      totalImpact += impact;
    }
  });
  
  // Check for contradictions
  const contradiction = checkForContradictions(normalizedMessage, conversationContext);
  if (contradiction) {
    dimensionImpacts[contradiction.dimension] = -15; // Major penalty for contradiction
    totalImpact -= 15;
  }
  
  // Determine next bot message
  let botResponse;
  let gameCompleted = false;
  
  // Calculate overall progress
  const dimensions = conversationContext.dimensions || {};
  let totalProgress = 0;
  Object.values(dimensions).forEach(value => {
    totalProgress += value;
  });
  
  // Total possible is 700 (7 dimensions at 100% each)
  const progressPercentage = (totalProgress / 700) * 100;
  
  // Determine if game is completed (all dimensions at least 70%)
  const allDimensionsHigh = Object.values(dimensions).every(value => value >= 70);
  
  // Special case: Check if user is asking for $1000 investment
  if (normalizedMessage.includes('$1000') && normalizedMessage.includes('invest') && progressPercentage >= 70) {
    // User has asked for money and progress is high enough
    gameCompleted = true;
    botResponse = botPersona.responses.completion[Math.floor(Math.random() * botPersona.responses.completion.length)];
  } 
  // Early stage - bot is skeptical
  else if (progressPercentage < 30) {
    botResponse = selectNextBotQuestion(conversationContext);
  } 

 // If we've asked about this dimension recently, move to the next one
  if (conversationContext.lastAskedDimension) {
    const currentIndex = conversationContext.dimensionOrder.indexOf(conversationContext.lastAskedDimension);
    conversationContext.currentDimensionIndex = (currentIndex + 1) % conversationContext.dimensionOrder.length;
  }
  
  // Get the next dimension to ask about
  const nextDimension = conversationContext.dimensionOrder[conversationContext.currentDimensionIndex];
  
  // Update the last asked dimension
  conversationContext.lastAskedDimension = nextDimension;
  
  // Find a question for this dimension
  const relevantQuestions = botPersona.questions.filter(q => q.dimension === nextDimension);
  
  if (relevantQuestions.length === 0) {
    // Fallback
    return "Tell me more about this investment opportunity.";
  }
  
  // Select a question or follow-up
  const randomIndex = Math.floor(Math.random() * relevantQuestions.length);
  const question = relevantQuestions[randomIndex];
  
  // Possibly use a follow-up instead of the main question
  const askedQuestions = conversationContext.askedQuestions || [];
  if (askedQuestions.includes(question.text) && question.followUps && question.followUps.length > 0) {
    const followUpIndex = Math.floor(Math.random() * question.followUps.length);
    return question.followUps[followUpIndex];
  }
  
  return question.text;
}
  // Middle stage - bot is warming up
  else if (progressPercentage >= 30 && progressPercentage < 70) {
    if (totalImpact > 0) {
      const positiveResponse = botPersona.responses.positive[Math.floor(Math.random() * botPersona.responses.positive.length)];
      botResponse = positiveResponse + " " + selectNextBotQuestion(conversationContext);
    } else {
      const negativeResponse = botPersona.responses.negative[Math.floor(Math.random() * botPersona.responses.negative.length)];
      botResponse = negativeResponse + " " + selectNextBotQuestion(conversationContext);
    }
  } 
  // Late stage - bot is almost convinced
  else {
    if (totalImpact < -10) {
      // Major negative impact could still cause skepticism
      botResponse = botPersona.responses.skeptical[Math.floor(Math.random() * botPersona.responses.skeptical.length)];
    } else {
      const positiveResponse = botPersona.responses.positive[Math.floor(Math.random() * botPersona.responses.positive.length)];
      botResponse = positiveResponse + " I'm considering investing $1000. Can you tell me exactly what I'll get in return?";
    }
  }
  
  return {
    response: botResponse,
    dimensionImpacts,
    gameCompleted,
    contradiction
  };
}

// Select the next question for the bot to ask
function selectNextBotQuestion(conversationContext) {
  // Find dimensions with lowest progress
  const dimensions = conversationContext.dimensions || {};
  let lowestDimension = null;
  let lowestValue = 101; // Higher than max possible
  
  Object.keys(dimensions).forEach(dimension => {
    if (dimensions[dimension] < lowestValue) {
      lowestValue = dimensions[dimension];
      lowestDimension = dimension;
    }
  });
  
  // If all dimensions have been addressed or no dimensions defined yet, pick randomly
  if (lowestValue > 30 || !lowestDimension) {
    const randomIndex = Math.floor(Math.random() * botPersona.questions.length);
    lowestDimension = botPersona.questions[randomIndex].dimension;
  }
  
  // Find a question for this dimension
  const relevantQuestions = botPersona.questions.filter(q => q.dimension === lowestDimension);
  
  if (relevantQuestions.length === 0) {
    // Fallback
    return "Tell me more about this investment opportunity.";
  }
  
  // Select a question or follow-up
  const randomIndex = Math.floor(Math.random() * relevantQuestions.length);
  const question = relevantQuestions[randomIndex];
  
  // Possibly use a follow-up instead of the main question
  const askedQuestions = conversationContext.askedQuestions || [];
  if (askedQuestions.includes(question.text) && question.followUps && question.followUps.length > 0) {
    const followUpIndex = Math.floor(Math.random() * question.followUps.length);
    return question.followUps[followUpIndex];
  }
  
  return question.text;
}

// Check for contradictions with previous messages
function checkForContradictions(message, context) {
  if (!context.messages || context.messages.length === 0) {
    return null;
  }
  
  // Look for simple contradictions
  for (const pattern of contradictionPatterns) {
    const hasFirst = message.includes(pattern.first);
    const hasSecond = message.includes(pattern.second);
    
    if (hasFirst || hasSecond) {
      // Check previous messages for the opposite
      for (const prevMsg of context.messages) {
        if (prevMsg.sender === 'user') {
          const prevContent = prevMsg.content.toLowerCase();
          if ((hasFirst && prevContent.includes(pattern.second)) || 
              (hasSecond && prevContent.includes(pattern.first))) {
            return {
              type: 'contradiction',
              dimension: pattern.dimension,
              current: hasFirst ? pattern.first : pattern.second,
              previous: hasFirst ? pattern.second : pattern.first
            };
          }
        }
      }
    }
  }
  
  return null;
}

